{
  "expo": {
    "name": "Zelvo",
    "slug": "zelvo",
    "scheme": "zelvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zelvo.app"
    },
    "android": {
      "package": "com.zelvo.app",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Zelvo uses the camera to photograph answer sheets.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zelvo opens the photos of answer sheets that you choose.",
          "microphonePermission": false
        }
      ]
    ],
    "owner": "okafor_onyedikachukwu_flourish01",
    "extra": {
      "eas": {
        "projectId": "736a28c5-8df4-439e-a598-746156b62aa5"
      }
    }
  }
}
